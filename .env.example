# Africa Invest environment configuration
# Copy to .env.local for development. Never commit secrets.

APP_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Africa Invest"

# development | test | staging | sandbox | production
NODE_ENV=development

# SQLite for local MVP. Production: PostgreSQL connection string.
DATABASE_URL="file:./dev.db"

# Session signing secret — generate a long random string in any non-local environment.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Provider selection. Use mock for MVP. Switch without changing domain logic.
IDENTITY_PROVIDER=mock
PAYMENT_PROVIDER=mock
FX_PROVIDER=mock
BROKER_PROVIDER=mock
CUSTODY_PROVIDER=mock
MARKET_DATA_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
DOCUMENT_PROVIDER=mock
TAX_PROVIDER=mock

# Demo / development controls (never enable in production)
ENABLE_DEMO_CONTROLS=true
ENABLE_DEMO_LOGIN=true

# Logging
LOG_LEVEL=info

# GCP (used when DOCUMENT_PROVIDER=gcs on Cloud Run)
# GCS_BUCKET=your-project-africa-invest-docs-sandbox
